# Supabase — Project Settings > API no painel do seu projeto
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-public-key-aqui

# NUNCA prefixar com NEXT_PUBLIC_ — só usada em Server Actions/Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Pagar.me — obtido no painel do Pagar.me/Stone (ADR-001)
PAGARME_API_KEY=
PAGARME_WEBHOOK_SECRET=
